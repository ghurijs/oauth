{
  "name": "@ghuri/oauth",
  "version": "0.1.0-alpha.0",
  "description": "Ghuri OAuth: Passport.js-style login strategies (OAuth2, OpenID Connect, local, magic link, bearer) for Workers and Node",
  "type": "module",
  "license": "MIT",
  "author": "Ghuri contributors",
  "homepage": "https://github.com/ghurijs/oauth#readme",
  "repository": { "type": "git", "url": "git+https://github.com/ghurijs/oauth.git" },
  "bugs": { "url": "https://github.com/ghurijs/oauth/issues" },
  "keywords": ["ghuri", "django", "oauth", "oauth2", "openid-connect", "oidc", "passport", "authentication", "cloudflare", "workers", "hono"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./rest": { "types": "./dist/rest.d.ts", "import": "./dist/rest.js" },
    "./testing": { "types": "./dist/testing.d.ts", "import": "./dist/testing.js" }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "LICENSE"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src test",
    "format": "biome format --write src test"
  },
  "peerDependencies": {
    "@ghuri/auth": "^0.1.0-alpha.1",
    "@ghuri/core": "^0.1.0-alpha.1",
    "@ghuri/rest": "^0.1.0-alpha.0",
    "hono": "^4.13.0"
  },
  "peerDependenciesMeta": { "@ghuri/rest": { "optional": true } },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@ghuri/auth": "^0.1.0-alpha.1",
    "@ghuri/core": "^0.1.0-alpha.1",
    "@ghuri/orm": "^0.1.0-alpha.1",
    "@ghuri/rest": "^0.1.0-alpha.0",
    "@types/node": "^24.0.0",
    "better-sqlite3": "^13.1.1",
    "esbuild": "^0.27.7",
    "hono": "^4.13.0",
    "miniflare": "^4.20260730.0",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  },
  "publishConfig": { "access": "public", "tag": "next" }
}
